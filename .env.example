# ==========================================
# OneRentals - Environment Configuration
# ==========================================

# 1. GitHub Content Management Configuration
# Generate a Personal Access Token on GitHub (Settings > Developer Settings > Personal access tokens)
# Scope needed: 'repo' (Contents: Read & write)
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere
GITHUB_OWNER=your-github-username
GITHUB_REPO=onerentals
GITHUB_BRANCH=main

# 2. Admin Authentication
# Set your secure password for the /admin portal
ADMIN_PASSWORD=admin123
# Or optional bcrypt hash:
ADMIN_PASSWORD_HASH=

# 3. Session Security
# 32+ character random secret string used to sign HttpOnly admin cookies
SESSION_SECRET=onerentals_secure_jwt_session_secret_key_minimum_32_chars_2026

# Note: Cloudinary is completely removed. Images are added directly using public online URLs (Unsplash, Imgur, CDN, etc.).
