# GitHub Content Management Configuration
# Generate a Personal Access Token (classic with 'repo' scope or fine-grained with Contents Read/Write)
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name
GITHUB_BRANCH=main

# Admin Authentication
# Generate hash with bcrypt or leave blank to use ADMIN_PASSWORD for initial dev
ADMIN_PASSWORD=admin123
ADMIN_PASSWORD_HASH=
SESSION_SECRET=super_secret_session_key_minimum_32_chars_long_12345

# Cloudinary Configuration for Image Uploads
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=cameracarrentals
